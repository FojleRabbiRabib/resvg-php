// resvg-php extension configuration for the Windows (MSVC) build system.
//
// Copyright 2026 Fojle Rabbi (Rabib)
// SPDX-License-Identifier: Apache-2.0
//
// The Windows counterpart of config.m4. The canonical `phpize && configure
// && nmake` path does not invoke cargo, so this script performs the same
// prelink steps: locate the Rust toolchain (rustup's per-user install is not
// on the machine PATH), build the shim static library for the MSVC target,
// refuse to configure without the vendored source, and link the resulting
// archive plus the system libraries Rust's standard library requires into
// php_resvg.dll.
//
// Export isolation needs no map file on this platform: the MSVC linker
// exports nothing unless declared, and the generated build marks get_module
// dllexport for shared extensions, so the DLL's export table is exactly
// {get_module} — the same property resvg.map (ELF) and resvg.exp (Mach-O)
// enforce.

ARG_ENABLE("resvg", "Enable resvg (SVG rasterization on a vendored resvg core)", "no");

if (PHP_RESVG != "no") {

	// resvg 0.48.x is edition 2024 (MSRV 1.85). Cargo commonly lives at
	// %USERPROFILE%\.cargo\bin, which is not on the machine PATH, so probe
	// that location explicitly before failing.
	var cargo_home = WshShell.ExpandEnvironmentStrings("%USERPROFILE%") + "\\.cargo\\bin";
	var cargo = PATH_PROG("cargo", cargo_home);
	if (!cargo) {
		ERROR("cargo not found. resvg builds its vendored renderer from Rust source and needs a\n" +
			"Rust toolchain >= 1.85 (resvg 0.48.x MSRV); install it via rustup (https://rustup.rs)\n" +
			"and re-run configure.");
	}

	var cargo_version = execute('"' + cargo + '" --version');
	var version = cargo_version.match(/cargo (\d+)\.(\d+)\./);
	if (!version || (parseInt(version[1]) < 2 && parseInt(version[2]) < 85)) {
		ERROR("cargo " + cargo_version.replace(/^\s+|\s+$/g, "") + " is older than the resvg 0.48.x\n" +
			"MSRV of 1.85. Install a current toolchain with rustup and re-run configure.");
	}

	// The shim crate's Cargo.toml points at the pinned, hash-verified vendored
	// source, which is gitignored and fetched only by the build drivers. Without
	// this check a clean checkout dies mid-build with a cryptic cargo
	// "path not found".
	var native_dir = configure_module_dirname + "\\native";
	if (!FSO.FileExists(configure_module_dirname + "\\vendor-src\\resvg-0.48.1\\crates\\resvg\\Cargo.toml")) {
		ERROR("vendored resvg source is missing at " + configure_module_dirname +
			"\\vendor-src. It is fetched and\nSHA-256-verified by tools/build.sh (Windows: " +
			"tools/build-windows.ps1); run that once before building.");
	}

	// Offline mode: crates resolve from native\vendor-crates (created by
	// tools/vendor-offline.sh) and cargo runs --frozen so it fails loudly
	// rather than reaching for the network. Resolved by the vendor directory's
	// presence rather than a flag, matching config.m4 so every configure
	// variant agrees.
	var cargo_flags = "--locked";
	if (FSO.FolderExists(native_dir + "\\vendor-crates")) {
		cargo_flags = "--frozen";
	}

	// Build the shim for the MSVC toolchain and record its system-library
	// requirements. --print=native-static-libs makes rustc report exactly which
	// import libraries a consumer of the archive must link — LTO strips the
	// automatic directives that would carry them — so the list comes from the
	// toolchain itself and tracks std changes instead of being hardcoded.
	var target = "x86_64-pc-windows-msvc";
	var build = execute('cmd /c "cd /d "' + native_dir + '" && "' + cargo + '" rustc --release'
		+ " --target " + target + " " + cargo_flags
		+ ' --crate-type staticlib -- --print=native-static-libs 2>&1"');
	var libs = build.match(/native-static-libs: (.+)/);
	if (!libs || !FSO.FileExists(native_dir + "\\target\\" + target + "\\release\\resvg_php.lib")) {
		ERROR("building the resvg shim (cargo, target " + target + ") did not succeed; cargo output follows.\n\n"
			+ build);
	}

	// Normalize the reported flags to link.exe spellings: "-lfoo" or "foo.lib"
	// both mean foo.lib; search paths and linker options are dropped.
	var import_libs = ["resvg_php.lib"];
	var tokens = libs[1].split(/\s+/);
	for (var i = 0; i < tokens.length; i++) {
		var tok = tokens[i];
		if (!tok || tok.charAt(0) == "/" || tok.indexOf("-L") == 0 || tok.indexOf("-F") == 0) {
			continue;
		}
		if (tok.indexOf("-l") == 0) {
			tok = tok.substring(2);
		}
		if (tok.length <= 4 || tok.substring(tok.length - 4) != ".lib") {
			tok += ".lib";
		}
		import_libs[import_libs.length] = tok;
	}
	ADD_FLAG("LIBS_RESVG", import_libs.join(" "));
	ADD_FLAG("LDFLAGS_RESVG", '/libpath:"' + native_dir + "\\target\\" + target + '\\release"');

	// PHP's Windows toolchain compiles at /W3 without warnings-as-errors; this
	// extension holds itself to -Wall -Wextra -Werror everywhere else, so the
	// warning bar travels with it here too.
	EXTENSION("resvg", "resvg.c resvg_options.c resvg_exception.c resvg_renderer.c resvg_document.c",
		PHP_RESVG_SHARED, "/W4 /WX /I\"" + configure_module_dirname + "\\native\\include\"");
}
